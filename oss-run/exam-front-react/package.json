{
  "name": "exam-front-react",
  "private": true,
  "version": "1.1.0",
  "description": "警院智慧考试平台前端（五平台约束规范 V1.0 技术基线：React + TypeScript + Vite + Ant Design 5 + GSAP 3）",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc --noEmit && vite build --mode production",
    "build:test": "tsc --noEmit && vite build --mode test",
    "build:staging": "tsc --noEmit && vite build --mode staging",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10"
  }
}
